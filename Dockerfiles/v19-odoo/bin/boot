currentdate=$(date +"%d.%m.%Y %T")
echo "Odoo Container starting now: $currentdate"

# Configuration file path
file="/opt/odoo/etc/odoo.conf"

# Only 'start' reads the configuration file. 'update' and 'neutralize' run
# odoo-bin bare, on purpose: they must not inherit the customer's addons_path,
# db_host or worker count. The price is that http_interface is unset for them,
# which Odoo 19 reports on every run - noise in the doup report for a process
# that never serves HTTP (--stop-after-init). Passing the value the running
# container uses anyway silences it without changing what the run does. It goes
# before "$@" so an explicit argument from the caller still wins.
interface_argument="--http-interface=0.0.0.0"

# 'update' and 'neutralize' run without -c on purpose (see above), and that also
# drops data_dir - Odoo then falls back to its default under $HOME. Every
# migration script that reads an attachment during the update (images,
# templates, packages) sees an empty filestore and fails, usually with a
# misleading error, while the running server reads the same records without
# trouble because it does load the configuration. Pass the one value those runs
# cannot do without; addons_path, db_host and worker count stay out by design.
# It goes before "$@" so an explicit argument from the caller still wins.
data_dir_argument=""
if [ -r "$file" ]; then
    configured_data_dir=$(sed -n 's/^[[:space:]]*data_dir[[:space:]]*=[[:space:]]*\(.*[^[:space:]]\)[[:space:]]*$/\1/p' "$file" | tail -n 1)
    if [ -n "$configured_data_dir" ]; then
        data_dir_argument="--data-dir=$configured_data_dir"
    fi
fi

# Fail hard and fast even on pipelines
set -eo pipefail

# Function: refresh_geoip
# Description: Brings the GeoIP database up to date before Odoo starts.
# Parameters: none
# Note: Odoo opens the database once during start-up and caches the reader, so
#   a refresh only takes effect if it happens before odoo-bin runs. We are still
#   root here, which the write to /usr/share/GeoIP needs.
#   The helper comes from the base image and defaults to DB-IP, which needs no
#   account; MaxMind is used instead as soon as GEOIPUPDATE_ACCOUNT_ID and
#   GEOIPUPDATE_LICENSE_KEY are in the environment. Older base images do not
#   carry the helper, hence the guard.
#   Never fatal: without a database Odoo simply leaves the visitor country
#   empty, which must not keep the server from starting.
function refresh_geoip {
    if command -v geoip-refresh > /dev/null 2>&1; then
        geoip-refresh || true
    fi
}

# Function: start
# Description: Starts the Odoo server with the specified configuration
# Parameters: Additional command line arguments for Odoo
function start {
    refresh_geoip

    echo "Running odoo..."
    set +e
    if [ ! -e $1 ]; then
        echo "...with additional args: $*"
    fi
    
    # Check if current user is already odoo
    if [ "$(whoami)" = "odoo" ]; then
        python3 /opt/odoo/odoo-server/odoo-bin -c $file $*
    else
        # Use su instead of sudo for user switching
        su - odoo --whitelist-environment=PGPASSWORD -c "python3 /opt/odoo/odoo-server/odoo-bin -c $file $*"
    fi

    SERVICE_PID=$!
    set -e
}

# Function: update
# Description: Updates all Odoo modules
# Parameters: Additional command line arguments for Odoo
# Note: --no-xmlrpc removed in Odoo 19 (XML-RPC deprecated), use --no-http if needed
function update {
    echo "update odoo..."
    set +e
    if [ ! -e $1 ]; then
        echo "...with additional args: $*"
    fi

    # Check if current user is already odoo
    if [ "$(whoami)" = "odoo" ]; then
        python3 /opt/odoo/odoo-server/odoo-bin --update=all --workers=0 --stop-after-init $interface_argument $data_dir_argument $*
    else
        # Use su instead of sudo for user switching
        su - odoo --whitelist-environment=PGPASSWORD -c "python3 /opt/odoo/odoo-server/odoo-bin --update=all --workers=0 --stop-after-init $interface_argument $data_dir_argument $*"
    fi

    SERVICE_PID=$!
    set -e
}

# Function: neutralize
# Description: Neutralizes the Odoo instance
# Parameters: Additional command line arguments for Odoo
# Note: --no-xmlrpc removed in Odoo 19 (XML-RPC deprecated), use --no-http if needed
function neutralize {
    echo "neutralize odoo..."
    set +e
    if [ ! -e $1 ]; then
        echo "...with additional args: $*"
    fi

    # Check if current user is already odoo
    if [ "$(whoami)" = "odoo" ]; then
        python3 /opt/odoo/odoo-server/odoo-bin neutralize --workers=0 --stop-after-init $interface_argument $data_dir_argument $*
    else
        # Use su instead of sudo for user switching
        su - odoo --whitelist-environment=PGPASSWORD -c "python3 /opt/odoo/odoo-server/odoo-bin neutralize --workers=0 --stop-after-init $interface_argument $data_dir_argument $*"
    fi

    SERVICE_PID=$!
    set -e
}

# Function: on_exit
# Description: Handles graceful shutdown on SIGINT and SIGTERM signals
function on_exit() {
    kill -TERM $SERVICE_PID
    wait $SERVICE_PID 2>/dev/null
    exit 0
}
trap on_exit INT TERM

# Check and setup data directory
datadir="/opt/odoo/data"
if [ "$(ls -A $datadir)" ]; then
    echo "$datadir is already exists"
else
    echo "Setting data directory permissions for odoo..."
    # If current user is root, use chown directly
    if [ "$(whoami)" = "root" ]; then
        chown -R odoo $datadir
    else
        # If not root and no sudo, this might be problematic
        # One solution would be to set file permissions beforehand
        echo "Warning: Cannot set ownership without root privileges. Make sure $datadir has correct permissions."
    fi
fi

# Execute all provided parameters
echo "Running parameters..."
# Re-split combined argument strings into words, then whitelist the command.
set -- $*
cmd_word="${1:-}"
case "$cmd_word" in
    start|update|neutralize)
        "$@"
        ;;
    *)
        echo "ERROR: refusing to run unknown command: '$*'" >&2
        echo "Allowed commands: start | update | neutralize" >&2
        exit 1
        ;;
esac

# Wait for all background processes to complete
wait